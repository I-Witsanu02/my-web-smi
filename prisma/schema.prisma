generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  CLINICIAN
  RESEARCHER
  DEMO
}

enum Sex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum CaseStatus {
  DRAFT
  SCREENED
  UPLOADED
  ROI_DETECTED
  PREDICTED
  REPORTED
  ARCHIVED
}

enum RiskFlag {
  NORMAL
  MONITOR
  POSSIBLE_DELAYED_GROWTH
  POSSIBLE_ADVANCED_MATURATION
  CLINICAL_REVIEW_SUGGESTED
}

enum QualityStatus {
  PASS
  REVIEW
  FAIL
}

enum AuditAction {
  LOGIN
  VIEW_CASE
  EDIT_CASE
  UPLOAD_IMAGE
  RUN_PREDICTION
  GENERATE_REPORT
  DOWNLOAD_REPORT
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  users       User[]
}

model User {
  id           String     @id @default(cuid())
  name         String?
  email        String     @unique
  displayName  String?
  passwordHash String?
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  auditLogs    AuditLog[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Patient {
  id              String   @id @default(cuid())
  anonymizedCode  String   @unique
  sex             Sex      @default(UNKNOWN)
  dateOfBirthHash String?
  cases           Case[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Case {
  id                String              @id
  patientId         String
  patient           Patient             @relation(fields: [patientId], references: [id])
  status            CaseStatus           @default(DRAFT)
  clinicalQuestion  String?
  referringUnit     String?
  clinicalIntake    ClinicalIntake?
  growthRecords     GrowthRecord[]
  growthScreening   GrowthScreening?
  xrayImages        XrayImage[]
  roiDetections     RoiDetection[]
  predictions       Prediction[]
  xaiResults        XaiResult[]
  reports           Report[]
  auditLogs         AuditLog[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model ClinicalIntake {
  id                  String   @id @default(cuid())
  caseId              String   @unique
  case                Case     @relation(fields: [caseId], references: [id])
  chronologicalAgeMo  Int
  heightCm            Float?
  weightKg            Float?
  bmi                 Float?
  fatherHeightCm      Float?
  motherHeightCm      Float?
  pubertySigns        String?
  endocrineHistory    String?
  consentConfirmed    Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model GrowthRecord {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  ageMonths Int
  heightCm  Float
  weightKg  Float?
  createdAt DateTime @default(now())
}

model GrowthScreening {
  id                         String   @id @default(cuid())
  caseId                     String   @unique
  case                       Case     @relation(fields: [caseId], references: [id])
  heightPercentile           Float?
  heightZScore               Float?
  weightPercentile           Float?
  weightZScore               Float?
  bmiPercentile              Float?
  bmiZScore                  Float?
  midParentalHeightCm        Float?
  growthVelocityCmPerYear    Float?
  riskFlag                   RiskFlag
  summary                    String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model XrayImage {
  id               String             @id @default(cuid())
  caseId           String
  case             Case               @relation(fields: [caseId], references: [id])
  objectBucket     String
  objectKey        String
  originalFilename String?
  contentType      String
  sizeBytes        Int?
  qualityCheck     ImageQualityCheck?
  roiDetections    RoiDetection[]
  predictions      Prediction[]
  xaiResults       XaiResult[]
  createdAt        DateTime           @default(now())
}

model ImageQualityCheck {
  id                     String        @id @default(cuid())
  xrayImageId            String        @unique
  xrayImage              XrayImage     @relation(fields: [xrayImageId], references: [id])
  handWristDetected      QualityStatus
  orientationStatus      QualityStatus
  brightnessContrast     QualityStatus
  blur                   QualityStatus
  markerTextInterference QualityStatus
  notes                  String?
  createdAt              DateTime      @default(now())
}

model RoiDetection {
  id              String   @id @default(cuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id])
  xrayImageId     String
  xrayImage       XrayImage @relation(fields: [xrayImageId], references: [id])
  label           String
  confidence      Float
  x               Float
  y               Float
  width           Float
  height          Float
  cropBucket      String?
  cropKey         String?
  createdAt       DateTime @default(now())
}

model Prediction {
  id                  String       @id @default(cuid())
  caseId              String
  case                Case         @relation(fields: [caseId], references: [id])
  xrayImageId         String
  xrayImage           XrayImage    @relation(fields: [xrayImageId], references: [id])
  modelVersionId      String
  modelVersion        ModelVersion @relation(fields: [modelVersionId], references: [id])
  chronologicalAgeMo  Int
  predictedBoneAgeMo  Int
  differenceMonths    Int
  uncertaintyMonths   Float
  interpretationFlag  RiskFlag
  disclaimer          String
  createdAt           DateTime     @default(now())
}

model XaiResult {
  id               String       @id @default(cuid())
  caseId           String
  case             Case         @relation(fields: [caseId], references: [id])
  xrayImageId      String
  xrayImage        XrayImage    @relation(fields: [xrayImageId], references: [id])
  modelVersionId   String
  modelVersion     ModelVersion @relation(fields: [modelVersionId], references: [id])
  method           String
  roiOverlap       Float?
  heatmapArea      Float?
  entropy          Float?
  processingTimeMs Int?
  heatmapBucket    String?
  heatmapKey       String?
  warning          String
  createdAt        DateTime     @default(now())
}

model Report {
  id           String   @id @default(cuid())
  caseId       String
  case         Case     @relation(fields: [caseId], references: [id])
  summary      String
  doctorNote   String?
  objectBucket String?
  objectKey    String?
  status       String   @default("draft")
  disclaimer   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  caseId    String?
  case      Case?       @relation(fields: [caseId], references: [id])
  action    AuditAction
  role      RoleName
  ipAddress String?
  metadata  Json?
  createdAt DateTime    @default(now())
}

model ModelVersion {
  id               String       @id @default(cuid())
  name             String       @unique
  architecture     String
  active           Boolean      @default(false)
  maeMonths        Float?
  rmseMonths       Float?
  inferenceCount   Int          @default(0)
  failedInferences Int          @default(0)
  ageSexDistribution Json?
  driftStatus      String?
  predictions      Prediction[]
  xaiResults       XaiResult[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}
