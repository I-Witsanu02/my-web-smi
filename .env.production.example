# Public Vercel URL of the separately deployed GPU inference API.
# This value is embedded while Vite builds the frontend. Set the same value in
# Vercel Project Settings > Environment Variables before deployment.
VITE_API_BASE_URL=https://your-boneage-gpu-api.example.com

# Keep anonymous uploads off by default. Set to 1 only for an explicitly
# approved, rate-limited public research demonstration.
VITE_PUBLIC_DEMO_ENABLED=0

# The following values belong only on the GPU backend. Never place them in
# Vercel's VITE_ variables or commit an .env file containing real credentials.
# BONEAGE_USERNAME=research_user
# BONEAGE_PASSWORD=use-a-long-unique-password
# BONEAGE_SESSION_SECRET=use-a-random-32-byte-or-longer-secret
# BONEAGE_ALLOWED_ORIGINS=https://your-vercel-project.vercel.app
# BONEAGE_HTTPS=1
